<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LamSims.App.MainWindow"
        Width="900" Height="640"
        MinWidth="760" MinHeight="480"
        Title="LamSims Updater">
  <DockPanel Margin="12">

    <!-- While shutdown waits for the runner the content stays visible and goes
         inert. Bound on the three content blocks rather than on the DockPanel so the stopping
         notice below is not dimmed along with the controls it explains. -->
    <StackPanel DockPanel.Dock="Top" Spacing="6" IsEnabled="{Binding !IsShuttingDown}">
      <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Game folder:" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding GameDirectory}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseGameCommand}" />
      </Grid>

      <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Catalog:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CatalogInput}"
                 PlaceholderText="A catalog.json path, or an https:// URL" />
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="Load" Command="{Binding ApplyCatalogSourceCommand}" />
          <Button Content="Browse" Command="{Binding ChangeCatalogCommand}" />
          <Button Content="Use cached copy" Command="{Binding UseCachedCatalogCommand}" />
        </StackPanel>
        <!-- The source actually in use, which differs from the box above whenever the box holds
             an edit the user has not pressed Load on yet. -->
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CatalogDescription}" Classes="secondary"
                   TextTrimming="CharacterEllipsis" />
      </Grid>

      <Expander Header="Advanced">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="Downloads:" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DownloadDirectory}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseDownloadsCommand}" />
          </Grid>
          <Grid ColumnDefinitions="110,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="Connections:" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="1" Maximum="16" Width="220"
                    Value="{Binding Connections}" />
            <TextBlock Grid.Column="2" Text="{Binding Connections}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="Wine prefix:" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding WinePrefix}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseWinePrefixCommand}" />
          </Grid>
        </StackPanel>
      </Expander>

      <!-- Hidden only when no backend reports support: the EA-client backend reports for
           Windows and the Wine backend for Linux, so this shows on either. On any other
           platform, including macOS, neither backend reports supported and this stays hidden
           rather than offering a control that cannot work.
           The nested DataContext is why the binding sweep has to re-root; without that, every
           binding below would read as unresolved. -->
      <Expander Header="DLC Unlocker" DataContext="{Binding Unlocker}"
                IsVisible="{Binding IsSupported}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0" Content="Select all"
                    Command="{Binding SelectAllCommand}" />
            <Button Grid.Column="1" Content="Select none"
                    Command="{Binding SelectNoneCommand}" />
            <Button Grid.Column="2" HorizontalAlignment="Right" Content="Refresh"
                    Command="{Binding RefreshCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Targets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                            IsEnabled="{Binding !IsBusy}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <!-- Title, not DisplayName: one flat property so the binding sweep can
                         resolve it, and it is where the environment appears off Windows. -->
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ClientPath}" Classes="secondary"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Per row rather than a banner: banners key by id, so a batch's warnings
                         would collapse to whichever target reported last. -->
                    <TextBlock Text="{Binding Warning}" Classes="secondary" TextWrapping="Wrap"
                               IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <!-- Wrapped, not trimmed: a failed operation puts its error message here, and
                       those interpolate paths and exception messages. There is no banner left to
                       carry them and no tooltip anywhere in this window, so trimming to the 220
                       cap would show the user "Instal…" and nothing else. The pack list wraps its
                       own status for the same reason. -->
                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" MaxWidth="220"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Why detection found less than the user expected: an unreadable launcher config, a
               32-bit prefix, a sandboxed build. The `secondary` class already exists and is
               styled; a new class here would fail ThemeSweepTests in both directions. -->
          <ItemsControl ItemsSource="{Binding DetectionNotes}"
                        IsVisible="{Binding HasDetectionNotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Classes="secondary" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0" Content="Install selected"
                    Command="{Binding InstallSelectedCommand}" />
            <Button Grid.Column="1" Content="Remove selected"
                    Command="{Binding RemoveSelectedCommand}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8"
                IsVisible="{Binding IsBusy}">
            <TextBlock Grid.Column="0" Text="{Binding BatchPosition}" Classes="secondary"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentStep}" VerticalAlignment="Center" />
            <!-- Total is bound, not just Completed: the step count each operation publishes is
                 only visible to a user if the bar knows where the end is. -->
            <ProgressBar Grid.Column="2" Width="120" Minimum="0"
                         Maximum="{Binding Total}" Value="{Binding Completed}"
                         VerticalAlignment="Center" />
            <!-- The denominator, not just the numerator: Total already reaches the bar's fill,
                 but without this the text beside it shows "7" where the design shows "7/10". -->
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Completed}" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="/" />
            <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding Total}" />
          </Grid>
          <Button Content="Restart as administrator"
                  Command="{Binding RelaunchElevatedCommand}"
                  IsVisible="{Binding RequiresElevation}" />
        </StackPanel>
      </Expander>

      <ItemsControl ItemsSource="{Binding Banners}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="banner"
                    Classes.warning="{Binding IsWarning}"
                    Classes.error="{Binding IsError}">
              <!-- Two columns rather than a horizontal StackPanel. A StackPanel measures
                   horizontally with infinite available width, so Stretch is inert and Wrap never
                   fires: the text lays out on one unbroken line and Dismiss (the only route to
                   clear a banner) is arranged off the window, with no horizontal scroll to
                   reach it. Banner text interpolates paths and exception messages. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding Text}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Dismiss"
                        Command="{Binding $parent[ItemsControl].DataContext.DismissBannerCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Content="Select all" Command="{Binding SelectAllCommand}" />
        <Button Grid.Column="1" Content="None" Command="{Binding SelectNoneCommand}" />
        <TextBlock Grid.Column="2" Text="Search:" VerticalAlignment="Center" />
        <TextBox Grid.Column="3" MinWidth="160" Text="{Binding SearchText}" />
        <Button Grid.Column="4" Content="Scan" Command="{Binding ScanCommand}" />
      </Grid>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0"
          IsEnabled="{Binding !IsShuttingDown}">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Pause" Command="{Binding PauseCommand}" />
      <Button Grid.Column="2" Content="Resume" Command="{Binding ResumeCommand}" />
      <Button Grid.Column="3" Content="Cancel all" Command="{Binding CancelAllCommand}" />
      <Button Grid.Column="4" Content="Add selected" Command="{Binding AddSelectedCommand}" />
    </Grid>

    <!-- The stopping state: the content stays visible and goes inert rather than being
         replaced, because shutdown waits for the runner and can take minutes on a large extract.
         A window that emptied itself would look like a crash. -->
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
               Text="Finishing up — waiting for the current pack to stop…"
               IsVisible="{Binding IsShuttingDown}" />

    <Grid ColumnDefinitions="2*,8,*" IsEnabled="{Binding !IsShuttingDown}">
      <Panel Grid.Column="0">
      <ListBox ItemsSource="{Binding FilteredRows}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="2">
              <!-- On the TEMPLATE ROOT, not on the ListBox. Compiled bindings are off in this
                   project, so a ContextMenu attached to the ListBox binds against the inherited
                   MainViewModel, where none of these three commands exist. It resolves to null
                   at runtime with no build error and no exception, and every item is dead. Inside
                   the template it inherits the row's DataContext. -->
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Cancel" Command="{Binding CancelCommand}" />
                  <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                  <!-- An Installed row's checkbox is disabled, and this is the only way
                       to re-check it. -->
                  <MenuItem Header="Reinstall anyway" Command="{Binding ReinstallCommand}" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <Grid ColumnDefinitions="Auto,Auto,2*,3*,Auto,Auto">
                <CheckBox Grid.Column="0" Margin="0,0,8,0"
                          IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsCheckable}" />
                <TextBlock Grid.Column="1" Text="{Binding Code}" MinWidth="56" Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="0,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" Margin="0,0,8,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Column="4" Classes="secondary" Text="{Binding SizeText}"
                           MinWidth="72" Margin="0,0,8,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="5" Width="120" Minimum="0" Maximum="100"
                             VerticalAlignment="Center"
                             Value="{Binding ProgressPercent}"
                             IsVisible="{Binding IsProgressVisible}" />
              </Grid>
              <TextBlock Text="{Binding Message}" Margin="28,0,0,0" TextWrapping="Wrap"
                         Classes.warning="{Binding IsWarning}"
                         Classes.error="{Binding IsError}"
                         IsVisible="{Binding Message,
                                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding CurrentEntry}" Margin="28,0,0,0" Classes="secondary"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding CurrentEntry,
                                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- LAST child, deliberately. A Panel draws in document order and the ListBox carries an
           opaque MantleBrush background, so a label declared before the list is painted and then
           covered. Nothing binds the list's IsVisible, so this overlays rather than hides. -->
      <TextBlock x:Name="EmptyState"
                 Text="{Binding EmptyStateMessage}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding EmptyStateMessage,
                             Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Panel>

      <Border Grid.Column="2" Classes="log" DataContext="{Binding Log}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                      Spacing="6" Margin="0,6,0,0">
            <Button Content="Copy" Command="{Binding CopyCommand}" />
            <Button Content="Clear" Command="{Binding ClearCommand}" />
          </StackPanel>
          <ScrollViewer Name="LogScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Lines}">
              <!-- Without this the default panel is a non-virtualizing StackPanel, which
                   realizes every one of the up-to-2000 capped lines as live controls, and every
                   trim at the cap removes index 0 and re-arranges every remaining child — the
                   only O(n)-per-line cost in the whole logging chain. -->
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="log-line secondary" Text="{Binding Time}" />
                    <TextBlock Grid.Column="1" Classes="log-line secondary" Text="{Binding Code}" />
                    <TextBlock Grid.Column="2" Classes="log-line" Text="{Binding Text}"
                               Classes.log-warning="{Binding IsWarning}"
                               Classes.log-error="{Binding IsError}"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

  </DockPanel>
</Window>
